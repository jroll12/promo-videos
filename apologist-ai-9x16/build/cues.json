  "captions": [
    {
      "text": "Picture your website",
      "start": 0.12,
      "end": 1.22
    },
    {
      "text": "at two in the morning.",
      "start": 1.22,
      "end": 2.34
    },
    {
      "text": "Someone arrives",
      "start": 2.34,
      "end": 3.06
    },
    {
      "text": "with a question",
      "start": 3.06,
      "end": 3.7
    },
    {
      "text": "they've never felt safe",
      "start": 3.7,
      "end": 4.74
    },
    {
      "text": "to ask out loud.",
      "start": 4.74,
      "end": 6.13
    },
    {
      "text": "Always be prepared",
      "start": 6.34,
      "end": 7.46
    },
    {
      "text": "to give an answer",
      "start": 7.46,
      "end": 8.74
    },
    {
      "text": "to everyone who asks you",
      "start": 8.74,
      "end": 10.5
    },
    {
      "text": "to give the reason",
      "start": 10.5,
      "end": 11.38
    },
    {
      "text": "for the hope",
      "start": 11.38,
      "end": 12.02
    },
    {
      "text": "that you have.",
      "start": 12.02,
      "end": 13.38
    },
    {
      "text": "The questions never stop.",
      "start": 13.38,
      "end": 15.62
    },
    {
      "text": "But your team",
      "start": 15.62,
      "end": 16.34
    },
    {
      "text": "can't answer them all.",
      "start": 16.34,
      "end": 17.69
    },
    {
      "text": "Generic AI hedges,",
      "start": 17.79,
      "end": 19.15
    },
    {
      "text": "misquotes Scripture,",
      "start": 19.15,
      "end": 20.43
    },
    {
      "text": "or quietly contradicts",
      "start": 20.43,
      "end": 21.87
    },
    {
      "text": "what you teach.",
      "start": 21.87,
      "end": 22.86
    },
    {
      "text": "Apologist AI puts",
      "start": 22.99,
      "end": 24.35
    },
    {
      "text": "a faithful, branded",
      "start": 24.35,
      "end": 25.79
    },
    {
      "text": "chatbot on your",
      "start": 25.79,
      "end": 26.91
    },
    {
      "text": "ministry's website.",
      "start": 26.91,
      "end": 28.44
    },
    {
      "text": "It answers from",
      "start": 28.51,
      "end": 29.31
    },
    {
      "text": "your own teaching,",
      "start": 29.31,
      "end": 30.43
    },
    {
      "text": "any hour, in any language,",
      "start": 30.43,
      "end": 32.35
    },
    {
      "text": "and cites its sources.",
      "start": 32.35,
      "end": 34.03
    },
    {
      "text": "When someone needs",
      "start": 34.03,
      "end": 34.91
    },
    {
      "text": "a real person,",
      "start": 34.91,
      "end": 36.33
    },
    {
      "text": "it passes them",
      "start": 36.33,
      "end": 37.13
    },
    {
      "text": "to your team.",
      "start": 37.13,
      "end": 38.27
    },
    {
      "text": "It's the number one",
      "start": 38.57,
      "end": 39.77
    },
    {
      "text": "Christian AI platform on",
      "start": 39.77,
      "end": 41.61
    },
    {
      "text": "The Gospel Coalition's",
      "start": 41.61,
      "end": 43.05
    },
    {
      "text": "2026 AI Christian Benchmark.",
      "start": 43.05,
      "end": 46.11
    },
    {
      "text": "It's trusted by Ligonier,",
