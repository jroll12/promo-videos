  "captions": [
    {
      "text": "Ask an AI",
      "start": 0.471,
      "end": 1.271
    },
    {
      "text": "to quote the Bible,",
      "start": 1.271,
      "end": 2.471
    },
    {
      "text": "and the words often",
      "start": 2.471,
      "end": 3.351
    },
    {
      "text": "come back wrong.",
      "start": 3.351,
      "end": 4.711
    },
    {
      "text": "It's not a bug.",
      "start": 4.711,
      "end": 5.991
    },
    {
      "text": "A model writes",
      "start": 5.991,
      "end": 6.831
    },
    {
      "text": "by guessing likely words,",
      "start": 6.831,
      "end": 8.471
    },
    {
      "text": "and every guess can drift.",
      "start": 8.471,
      "end": 10.498
    },
    {
      "text": "So the fix isn't",
      "start": 10.498,
      "end": 11.431
    },
    {
      "text": "a smarter model",
      "start": 11.431,
      "end": 12.311
    },
    {
      "text": "or new settings.",
      "start": 12.311,
      "end": 13.351
    },
    {
      "text": "It's the method.",
      "start": 13.351,
      "end": 14.721
    },
    {
      "text": "We tested five methods,",
      "start": 14.871,
      "end": 16.631
    },
    {
      "text": "33,000 times.",
      "start": 16.631,
      "end": 18.791
    },
    {
      "text": "Alone, the model",
      "start": 18.791,
      "end": 19.911
    },
    {
      "text": "was exactly right",
      "start": 19.911,
      "end": 20.871
    },
    {
      "text": "about a third of the time.",
      "start": 20.871,
      "end": 22.471
    },
    {
      "text": "With web search,",
      "start": 22.471,
      "end": 23.551
    },
    {
      "text": "under half.",
      "start": 23.551,
      "end": 24.631
    },
    {
      "text": "Handed the passage,",
      "start": 24.631,
      "end": 25.831
    },
    {
      "text": "93 percent.",
      "start": 25.831,
      "end": 27.351
    },
    {
      "text": "Using a lookup tool, 96.",
      "start": 27.351,
      "end": 29.911
    },
    {
      "text": "One method got",
      "start": 29.911,
      "end": 30.871
    },
    {
      "text": "every English quote",
      "start": 30.871,
      "end": 31.991
    },
    {
      "text": "exactly right.",
      "start": 31.991,
      "end": 33.441
    },
    {
      "text": "The model never",
      "start": 33.741,
      "end": 34.621
    },
    {
      "text": "writes the verse.",
      "start": 34.621,
      "end": 35.741
    },
    {
      "text": "It leaves a placeholder,",
      "start": 35.741,
      "end": 36.941
    },
    {
      "text": "like John 3:16,",
      "start": 36.941,
      "end": 38.541
