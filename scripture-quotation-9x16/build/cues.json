  "captions": [
    {
      "text": "Ask an AI",
      "start": 0.39,
      "end": 1.554
    },
    {
      "text": "to quote the Bible,",
      "start": 1.554,
      "end": 2.924
    },
    {
      "text": "and the words often",
      "start": 2.924,
      "end": 4.294
    },
    {
      "text": "come back wrong.",
      "start": 4.294,
      "end": 5.672
    },
    {
      "text": "It's not a bug.",
      "start": 5.672,
      "end": 7.041
    },
    {
      "text": "A model writes",
      "start": 7.041,
      "end": 8.069
    },
    {
      "text": "by guessing likely words,",
      "start": 8.069,
      "end": 9.439
    },
    {
      "text": "and every guess can drift.",
      "start": 9.439,
      "end": 11.501
    },
    {
      "text": "So the fix isn't",
      "start": 11.501,
      "end": 12.871
    },
    {
      "text": "a smarter model",
      "start": 12.871,
      "end": 13.898
    },
    {
      "text": "or new settings.",
      "start": 13.898,
      "end": 14.926
    },
    {
      "text": "It's the method.",
      "start": 14.926,
      "end": 16.333
    },
    {
      "text": "We tested five methods,",
      "start": 16.903,
      "end": 18.273
    },
    {
      "text": "33,000 times.",
      "start": 18.273,
      "end": 19.993
    },
    {
      "text": "Alone, the model",
      "start": 19.993,
      "end": 21.02
    },
    {
      "text": "was exactly right",
      "start": 21.02,
      "end": 22.048
    },
    {
      "text": "about a third of the time.",
      "start": 22.048,
      "end": 24.102
    },
    {
      "text": "With web search,",
      "start": 24.102,
      "end": 25.13
    },
    {
      "text": "under half.",
      "start": 25.13,
      "end": 25.815
    },
    {
      "text": "Handed the passage,",
      "start": 25.815,
      "end": 26.842
    },
    {
      "text": "93 percent.",
      "start": 26.842,
      "end": 27.869
    },
    {
      "text": "Using a lookup tool, 96.",
      "start": 27.869,
      "end": 30.274
    },
    {
      "text": "One method got",
      "start": 30.274,
      "end": 31.302
    },
    {
      "text": "every English quote",
      "start": 31.302,
      "end": 32.329
    },
    {
      "text": "exactly right.",
      "start": 32.329,
      "end": 33.394
    },
    {
      "text": "The model never",
      "start": 34.114,
      "end": 35.141
    },
    {
      "text": "writes the verse.",
      "start": 35.141,
      "end": 36.169
    },
    {
      "text": "It leaves a placeholder,",
      "start": 36.169,
      "end": 37.539
    },
    {
      "text": "like John 3:16,",
      "start": 37.539,
      "end": 38.908
    },
    {
      "text": "and the software",
      "start": 38.908,
      "end": 39.936
    },
    {
      "text": "fills in the exact text",
      "start": 39.936,
      "end": 41.648
    },
    {
      "text": "from a licensed",
      "start": 41.648,
      "end": 42.676
    },
    {
      "text": "Bible source.",
      "start": 42.676,
      "end": 43.711
    },
    {
